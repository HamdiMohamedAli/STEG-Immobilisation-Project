@startuml
actor Administrateur as Admin
boundary "IHM Gestion Utilisateurs" as IHM
control "Système / Contrôleur" as Sys
database "Base de Données" as BDD

alt Création d'un utilisateur
    Admin -> IHM: Saisir les informations (nom, email, tel, mdp, profilId)
    Admin -> IHM: Cliquer sur "Enregistrer"
    IHM -> Sys: creerUtilisateur(nom, email, tel, motDePasse, profilId)
    
    ' The database inserts the user with a default status of "Actif"
    Sys -> BDD: insererUtilisateur(nom, email, tel, motDePasse, profilId, statut="Actif")
    BDD --> Sys: Confirmation (Retourne idUtilisateur généré)
    
    Sys -> BDD: JournalLog.enregistrerTrace("Création", "Utilisateur", idUtilisateur)
    Sys --> IHM: Succès de l'enregistrement (ID: idUtilisateur)

else Modification d'un utilisateur
    Admin -> IHM: Sélectionner un utilisateur et modifier ses données
    Admin -> IHM: Cliquer sur "Modifier"
    IHM -> Sys: modifierUtilisateur(idUtilisateur, nom, email, tel, motDePasse, profilId)
    Sys -> BDD: verifierExistenceUtilisateur(idUtilisateur)
    BDD --> Sys: ID existant
    Sys -> BDD: majUtilisateur(idUtilisateur, nom, email, tel, motDePasse, profilId)
    BDD --> Sys: Confirmation mise à jour
    Sys -> BDD: JournalLog.enregistrerTrace("Modification", "Utilisateur", idUtilisateur)
    Sys --> IHM: Succès de la modification

else Suppression d'un utilisateur (Désactivation logique)
    Admin -> IHM: Sélectionner un utilisateur et cliquer sur "Supprimer"
    IHM -> Sys: supprimerUtilisateur(idUtilisateur)
    Sys -> BDD: verifierExistenceUtilisateur(idUtilisateur)
    BDD --> Sys: ID existant
    
    ' FIX: Changed from hard delete to soft delete using the status column
    Sys -> BDD: majStatutUtilisateur(idUtilisateur, statut="Inactif")
    BDD --> Sys: Confirmation de la désactivation
    
    Sys -> BDD: JournalLog.enregistrerTrace("Désactivation", "Utilisateur", idUtilisateur)
    Sys --> IHM: Succès de la suppression logique
end

IHM --> Admin: Rafraîchir et afficher la liste à jour des utilisateurs
@enduml